    "text": "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"x402 Trust Oracle Discovery API\",\"version\":\"1.0.0\",\"description\":\"Check x402 endpoints before your agent trades. Shows whether an x402 endpoint is fresh, fast, and live, so your agent skips degraded endpoints before missed fills and wrong positions.\",\"x-guidance\":\"x402 Trust Oracle is a pre-payment trust oracle for x402 endpoints. Before an autonomous agent pays an x402 endpoint, call GET https://api.x402oracle.com/v1/check?resource=<absolute-https-url> for a full graded trust verdict (decision allow/warn/block/unknown plus liveness, freshness, and price/payTo/chain drift), or GET https://api.x402oracle.com/v1/trade-check?resource=<absolute-https-url> for the latency-optimized pre-trade facts (no score). Both are PAID x402 routes: an unpaid request returns HTTP 402 with the x402 payment challenge; retry with a valid X-PAYMENT for that route. The oracle never pays the target endpoint being checked.\",\"contact\":{\"email\":\"contact@smithersbot.com\"}},\"servers\":[{\"url\":\"https://api.x402oracle.com\"}],\"paths\":{\"/v1/check\":{\"get\":{\"operationId\":\"check\",\"summary\":\"Full pre-payment x402 trust verdict\",\"description\":\"Full pre-payment trust verdict for an x402 endpoint: health, latency, drift, and monitoring history.\",\"requestBody\":{\"required\":true,\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"properties\":{\"resource\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":2048,\"pattern\":\"^https://\",\"description\":\"Absolute https x402 endpoint URL to check before sending payment.\"},\"expectedPayTo\":{\"type\":\"string\",\"pattern\":\"^0x[0-9a-fA-F]{40}$\",\"description\":\"Optional expected receiving wallet address for drift checks.\"},\"maxUsdPrice\":{\"type\":\"string\",\"description\":\"Optional non-negative USD price ceiling for the checked endpoint.\"},\"maxAgeSeconds\":{\"type\":\"string\",\"description\":\"Optional non-negative integer freshness limit for the trust decision.\"}},\"required\":[\"resource\"],\"additionalProperties\":false}}}},\"x-payment-info\":{\"price\":{\"mode\":\"fixed\",\"currency\":\"USD\",\"amount\":\"0.002\"},\"protocols\":[{\"x402\":{}}]},\"responses\":{\"200\":{\"description\":\"Paid trust response.\",\"content\":{\"application/json\":{\"schema\":{\"type\":\"object\",\"properties\":{\"v\":{\"type\":\"integer\"},\"resource\":{\"type\":\"string\"},\"decision\":{\"type\":\"string\",\"enum\":[\"allow\",\"warn\",\"block\",\"unknown\"]},\"score\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"observedAt\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"ageSeconds\":{\"anyOf\":[{\"type\":\"integer\"},{\"type\":\"null\"}]},\"history\":{\"type\":\"object\",\"properties\":{\"windowSeconds\":{\"type\":\"integer\"},\"targetWindowSeconds\":{\"type\":\"integer\"},\"complete\":{\"type\":\"boolean\"}},\"required\":[\"windowSeconds\",\"targetWindowSeconds\",\"complete\"],\"additionalProperties\":false},\"price\":{\"type\":\"object\",\"properties\":{\"usd\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"currency\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"changeCount\":{\"anyOf\":[{\"type\":\"integer\"},{\"type\":\"null\"}]},\"distinct\":{\"anyOf\":[{\"type\":\"integer\"},{\"type\":\"null\"}]},\"rangeRatio\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"vsLow\":{\"anyOf\":[{\"type\":\"number\"},{\"type\":\"null\"}]},\"changed24h\":{\"type\":\"boolean\"},\"lastChangeAgeSeconds\":{\"anyOf\":[{\"type\":\"integer\"},{\"type\":\"null\"}]}},\"required\":[\"usd\",\"currency\",\"changeCount\",\"distinct\",\"rangeRatio\",\"vsLow\",\"changed24h\",\"lastChangeAgeSeconds\"],\"additionalProperties\":false},\"config\":{\"type\":\"object\",\"properties\":{\"payTo\":{\"type\":\"object\",\"properties\":{\"value\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"changeCount\":{\"anyOf\":[{\"type\":\"integer\"},{\"type\":\"null\"}]},\"distinct\":{\